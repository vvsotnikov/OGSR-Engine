<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="..\OgsrBuildProps.props" />

  <Import Project="Engine_paths.props" />
  <PropertyGroup>
    <OutDir>$(OgsrEngineLibraryDir)</OutDir>
    <IntDir>$(OgsrEngineIntermediateDir)</IntDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AssemblerListingLocation>$(OgsrEngineIntermediateDir)</AssemblerListingLocation>
      <ObjectFileName>$(OgsrEngineIntermediateDir)</ObjectFileName>
      <ProgramDataBaseFileName>$(OgsrEngineIntermediateDir)</ProgramDataBaseFileName>
      <AdditionalOptions>/source-charset:utf-8 /we4566 /we4828 /we4715 /we4189 /we4595 /we4834 /we4018 /we4101 /we4552 /we4551 /we4477 /we4390 /we4806 /we4002 /we4302 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(SolutionDir)\3rd_party\Src\tracy\public;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>
        _CRT_SECURE_NO_WARNINGS;
        _SILENCE_CXX17_CODECVT_HEADER_DEPRECATION_WARNING;
        %(PreprocessorDefinitions)
      </PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <ImportLibrary>$(OgsrEngineLibraryDir)$(TargetName).lib</ImportLibrary>
      <AdditionalLibraryDirectories>$(SolutionDir)\3rd_party\Src\NVIDIA_DLSS\DLSS\lib\Windows_x86_64\x64;$(SolutionDir)\3rd_party\_LIB\$(OgsrThirdPartyConfiguration)\$(Platform);$(OgsrEngineLibraryDir);$(SolutionDir)\3rd_party\Src\OpenAL_Soft\libs\$(PlatformShortName);$(SolutionDir)\3rd_party\_LIB\Release\$(Platform);</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(OgsrBuildVariant)'=='ReleaseTracyProfiler'">
    <ClCompile>
      <PreprocessorDefinitions>
        TRACY_ENABLE;
        TRACY_NO_FRAME_IMAGE;
        TRACY_ON_DEMAND;
        %(PreprocessorDefinitions)
      </PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>