<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- A newly added/removed optional header is not in CL's old dependency log.
       Change the compiler command line too, so incremental builds cannot miss it. -->
  <ItemDefinitionGroup Condition="Exists('$(MSBuildThisFileDirectory)build_config_overrides/build_config_defines.h')">
    <ClCompile>
      <PreprocessorDefinitions>OGSR_BUILD_CONFIG_OVERRIDE_PRESENT;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug' and '$(OgsrRequireDebugAssertions)'=='true'">
    <ClCompile>
      <PreprocessorDefinitions>OGSR_REQUIRE_DEBUG_ASSERTIONS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
