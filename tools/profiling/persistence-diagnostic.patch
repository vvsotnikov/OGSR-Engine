@@ -21,6 +21,7 @@
 #include "string_table.h"
 #include "HUDManager.h"
 #include "..\xr_3da\DiscordRPC.hpp"
+#include <fstream>
 
 #ifndef MASTER_GOLD
 #include "custommonster.h"
@@ -563,6 +564,34 @@ void CGamePersistent::OnFrame()
     if (!g_pGameLevel->bReady)
         return;
 
+    // Disposable validation build only: publish numbered command files atomically.
+    // Poll on the main thread after loading; never inject input or run from ALife workers.
+    if (strstr(Core.Params, "-alife_validation"))
+    {
+        static u32 next_command = 1;
+        static ULONGLONG next_poll = 0;
+        if (GetTickCount64() >= next_poll && Device.dwPrecacheFrame == 0 && !load_screen_renderer.b_registered)
+        {
+            next_poll = GetTickCount64() + 1000;
+            string_path relative, path;
+            xr_sprintf(relative, "validation_%03u.txt", next_command);
+            FS.update_path(path, "$app_data_root$", relative);
+            std::ifstream input(path);
+            std::string command;
+            if (std::getline(input, command))
+            {
+                ++next_command;
+                const bool allowed = command == "quit" || command.find("save validation_") == 0 ||
+                    command.find("load validation_") == 0 || command == "jump_to_level l02_garbage" ||
+                    command == "jump_to_level l05_bar";
+                Msg("[ALife validation] command=%s allowed=%u", command.c_str(), u32(allowed));
+                if (allowed)
+                    Console->Execute(command.c_str());
+                return;
+            }
+        }
+    }
+
     if (Device.Paused())
     {
 #ifndef MASTER_GOLD
diff --git a/ogsr_engine/xrGame/alife_update_manager.cpp b/ogsr_engine/xrGame/alife_update_manager.cpp
